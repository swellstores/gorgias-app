{
	"$schema": "node_modules/wrangler/config-schema.json",
	// One Worker serves every store that installs the app. Its public URL is
	// registered with Gorgias as the app's App URL (/oauth/install) and
	// Redirect URL (/oauth/callback), so keep the name stable: renaming the
	// Worker changes those URLs.
	"name": "swell-gorgias",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	// Secrets, set once with `npx wrangler secret put <NAME>` in this folder
	// (never in this file, which is uploaded to Swell with the app):
	//   GORGIAS_CLIENT_ID, GORGIAS_CLIENT_SECRET, STATE_SECRET
}
